# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EXTERNAL_SHIFTS_API_URL: Optional default HTTPS endpoint for external company shift sync (server-side).
EXTERNAL_SHIFTS_API_URL=""

# EXTERNAL_SHIFTS_API_TOKEN: Optional secret Bearer token for external company shift API (server-side ONLY, never exposed to client).
EXTERNAL_SHIFTS_API_TOKEN=""

# VITE_GOOGLE_MAPS_API_KEY: Optional Google Maps Platform API key for Live Representatives Map.
# Restrict this key by HTTP Referrer (e.g. https://yourdomain.infinityfreeapp.com/*) in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_API_BASE_URL: Optional external Node.js backend base URL ONLY if using /api/external-sync with a secret server token.
# Leave empty on InfinityFree Static Hosting (Firebase Auth, Firestore, Google Sheets OAuth Sync, and JSON Backup work 100% directly from the browser).
VITE_API_BASE_URL=""

# Optional Capacitor Android identity overrides (defaults read from app-identity.json)
CAP_APP_ID=""
CAP_APP_NAME=""
