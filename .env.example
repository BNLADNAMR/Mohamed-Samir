# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EXTERNAL_SHIFTS_API_URL: Optional default HTTPS endpoint for external company shift sync (server-side).
EXTERNAL_SHIFTS_API_URL=""

# EXTERNAL_SHIFTS_API_TOKEN: Optional secret Bearer token for external company shift API (server-side ONLY, never exposed to client).
EXTERNAL_SHIFTS_API_TOKEN=""

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for Live Representatives Monitoring Map.
# Automatically injected by AI Studio secret store when Google Maps is enabled.
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_API_BASE_URL: Optional backend base URL used by Capacitor Android builds for /api/* routes (leave empty on Web).
VITE_API_BASE_URL=""

# Optional Capacitor Android identity overrides (defaults read from app-identity.json)
CAP_APP_ID=""
CAP_APP_NAME=""


