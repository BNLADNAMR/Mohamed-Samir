rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. القفل العام الافتراضي (Default Deny Catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // الدوال المساعدة وحماية الهوية (Zero-Trust ABAC Helpers)
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        (request.auth.token.phone_number != null && request.auth.token.phone_number.size() >= 8) ||
        (request.auth.token.firebase != null && request.auth.token.firebase.sign_in_provider in ['phone', 'google.com', 'password'])
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOptionalId(id) {
      return id is string && id.size() <= 128 && (id.size() == 0 || id.matches('^[a-zA-Z0-9_\\-]+$'));
    }

    function isBootstrappedAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'aladdinamrr@gmail.com';
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasActiveProfile() {
      return isSignedIn() &&
        exists(userDocPath(request.auth.uid)) &&
        get(userDocPath(request.auth.uid)).data.status == 'active';
    }

    function currentUserData() {
      return get(userDocPath(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return hasActiveProfile() && currentUserData().role == 'super_admin';
    }

    function isOperationsManager() {
      return hasActiveProfile() && currentUserData().role == 'operations_manager';
    }

    function isSupervisor() {
      return hasActiveProfile() && currentUserData().role == 'supervisor';
    }

    function isDeliveryRep() {
      return hasActiveProfile() && currentUserData().role == 'delivery_rep';
    }

    function isValidRole(r) {
      return r in ['super_admin', 'operations_manager', 'supervisor', 'delivery_rep', 'viewer'];
    }

    function isBoundedStringArray(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 64));
    }

    function securityPolicyDocPath() {
      return /databases/$(database)/documents/securitySettings/global;
    }

    function isNonAdminWriteUnlocked() {
      return !exists(securityPolicyDocPath()) || (
        (!('emergencyReadOnlyMode' in get(securityPolicyDocPath()).data) || get(securityPolicyDocPath()).data.emergencyReadOnlyMode == false) &&
        (!('systemLockdownMode' in get(securityPolicyDocPath()).data) || get(securityPolicyDocPath()).data.systemLockdownMode == false)
      );
    }

    function isSystemNotLockedDown() {
      return !exists(securityPolicyDocPath()) ||
        !('systemLockdownMode' in get(securityPolicyDocPath()).data) ||
        get(securityPolicyDocPath()).data.systemLockdownMode == false;
    }

    // ---------------------------------------------------------
    // 1. المستخدمون /users/{userId}
    // الدور الافتراضي لأي مستخدم جديد هو delivery_rep (Representative)
    // ---------------------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isOperationsManager()
      );

      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        isOperationsManager()
      );

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          // مدير النظام المؤسس
          (
            request.auth.uid == userId &&
            isBootstrappedAdminEmail() &&
            incoming().role == 'super_admin' &&
            incoming().status == 'active'
          ) ||
          // المستخدمون الجدد (الدور إلزامي: مندوب delivery_rep ولا يمكن ترقية النفس)
          (
            request.auth.uid == userId &&
            incoming().role == 'delivery_rep' &&
            incoming().status in ['active', 'pending'] &&
            incoming().extraPermissions.size() == 0 &&
            incoming().revokedPermissions.size() == 0
          ) ||
          // إنشاء حساب من قبل Super Admin
          isSuperAdmin()
        );

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // تحديث الحساب الشخصي (بدون تعديل الصلاحيات أو الدور إطلاقاً)
          (
            request.auth.uid == userId &&
            existing().status == 'active' &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().extraPermissions == existing().extraPermissions &&
            incoming().revokedPermissions == existing().revokedPermissions &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'phone', 'jobTitle', 'department', 'bio',
              'personalSessionTimeoutMinutes', 'requireReauthForSensitiveActions',
              'securityAlertsEnabled', 'lastPasswordChangedAt', 'lastLoginAt', 'updatedAt'
            ])
          ) ||
          // تعديل من قبل مدير النظام Super Admin
          (
            isSuperAdmin() &&
            (request.auth.uid != userId || (incoming().role == 'super_admin' && incoming().status == 'active'))
          )
        );

      allow delete: if isVerifiedUser() && isValidId(userId) && isSuperAdmin() && request.auth.uid != userId && existing().role != 'super_admin';
    }

    // ---------------------------------------------------------
    // 2. المندوبون /employees/{employeeId}
    // ---------------------------------------------------------
    match /employees/{employeeId} {
      allow get: if isSignedIn() && isValidId(employeeId) && (
        isSuperAdmin() ||
        isOperationsManager() ||
        (isSupervisor() && existing().teamId == currentUserData().teamId) ||
        (isDeliveryRep() && (employeeId == currentUserData().employeeId || existing().userId == request.auth.uid))
      );

      allow list: if isSignedIn();

      allow create: if isVerifiedUser() && isValidId(employeeId) && (
        isSuperAdmin() ||
        (isOperationsManager() && isNonAdminWriteUnlocked())
      );

      allow update: if isVerifiedUser() && isValidId(employeeId) && (
        isSuperAdmin() ||
        (isOperationsManager() && isNonAdminWriteUnlocked()) ||
        (isSupervisor() && isNonAdminWriteUnlocked() && existing().teamId == currentUserData().teamId)
      );

      allow delete: if isVerifiedUser() && isValidId(employeeId) && isSuperAdmin();
    }

    // ---------------------------------------------------------
    // 3. الحضور والشفتات /attendance/{recordId}
    // ---------------------------------------------------------
    match /attendance/{recordId} {
      allow get, list: if isSignedIn();

      allow create: if isVerifiedUser() && isValidId(recordId) && (
        isSuperAdmin() ||
        (isNonAdminWriteUnlocked() && (isOperationsManager() || isSupervisor()))
      );

      allow update: if isVerifiedUser() && isValidId(recordId) && (
        isSuperAdmin() ||
        (isNonAdminWriteUnlocked() && (isOperationsManager() || isSupervisor()))
      );

      allow delete: if isVerifiedUser() && isValidId(recordId) && (isSuperAdmin() || isOperationsManager());
    }

    // ---------------------------------------------------------
    // 4. فرق العمل /teams/{teamId}
    // ---------------------------------------------------------
    match /teams/{teamId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isVerifiedUser() && isValidId(teamId) && isSuperAdmin();
    }

    // ---------------------------------------------------------
    // 5. الطلبات والإجازات /requests/{requestId}
    // ---------------------------------------------------------
    match /requests/{requestId} {
      allow get, list: if isSignedIn();

      allow create: if isVerifiedUser() && isValidId(requestId) &&
        incoming().requestId == requestId &&
        incoming().submittedBy == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() && isValidId(requestId) && (
        isSuperAdmin() ||
        (isOperationsManager() && isNonAdminWriteUnlocked()) ||
        (isSupervisor() && isNonAdminWriteUnlocked() && existing().submittedBy != request.auth.uid)
      );

      allow delete: if false;
    }

    // ---------------------------------------------------------
    // 6. سجل الرقابة /auditLogs/{logId}
    // ---------------------------------------------------------
    match /auditLogs/{logId} {
      allow get, list: if isSignedIn() && (isSuperAdmin() || isOperationsManager());
      allow create: if isVerifiedUser() && isValidId(logId) && incoming().actorUserId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // 7. سياسات الأمان /securitySettings/{policyId}
    // ---------------------------------------------------------
    match /securitySettings/{policyId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isSuperAdmin();
      allow create, update: if isVerifiedUser() && isSuperAdmin();
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // 8. الدعوات المسبقة /preprovisionedUsers/{emailKey}
    // ---------------------------------------------------------
    match /preprovisionedUsers/{emailKey} {
      allow get: if isVerifiedUser() && (isSuperAdmin() || existing().email == request.auth.token.email);
      allow list, create, update, delete: if isVerifiedUser() && isSuperAdmin();
    }
  }
}
